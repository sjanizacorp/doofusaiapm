[Unit]
Description=DoofusAI platform collector %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=doofusai
Group=doofusai
WorkingDirectory=/opt/doofusai-agents/%i
EnvironmentFile=-/etc/doofusai/agent-%i.conf
ExecStart=/usr/bin/python3 /opt/doofusai-agents/%i/agent.py run --config /opt/doofusai-agents/%i/agent.json --token-file /opt/doofusai-agents/%i/agent.token
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
